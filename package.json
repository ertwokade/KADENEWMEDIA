{
  "name": "kade-media-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"corepack pnpm dev:web\" \"corepack pnpm dev:worker\"",
    "dev:web": "corepack pnpm --filter @kade/studio-web dev",
    "dev:worker": "corepack pnpm --filter @kade/studio-worker dev",
    "start": "corepack pnpm --filter @kade/studio-web start",
    "build": "corepack pnpm -r --filter @kade/editor-core --filter @kade/shared --filter @kade/db --filter @kade/studio-web --filter @kade/studio-worker build",
    "lint": "corepack pnpm -r --filter @kade/editor-core --filter @kade/shared --filter @kade/db --filter @kade/studio-web --filter @kade/studio-worker lint",
    "typecheck": "corepack pnpm -r --filter @kade/editor-core --filter @kade/shared --filter @kade/db --filter @kade/studio-web --filter @kade/studio-worker typecheck",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration",
    "test:unit": "corepack pnpm --filter @kade/editor-core test",
    "test:integration": "corepack pnpm --filter @kade/studio-web test:integration",
    "test:e2e": "corepack pnpm --filter @kade/studio-web test:e2e",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:generate": "corepack pnpm --filter @kade/db generate",
    "db:migrate": "corepack pnpm --filter @kade/db migrate",
    "db:studio": "corepack pnpm --filter @kade/db studio",
    "demo:fixture": "corepack pnpm --filter @kade/studio-worker fixture",
    "demo:seed": "corepack pnpm --filter @kade/studio-worker seed",
    "legacy:dev": "vite",
    "legacy:build": "vite build && node -e \"require('fs').renameSync('dist/index.html','dist/app.html')\" && node scripts/generate-static-routes.mjs",
    "legacy:lint": "eslint .",
    "legacy:test:unit": "node --test tests/unit/*.test.js",
    "dev:api": "node server.js",
    "dev:kadeai": "npm --prefix apps/kadeai run dev",
    "build:kadeai": "npm --prefix apps/kadeai run build",
    "build:all": "corepack pnpm legacy:build && corepack pnpm build:kadeai && corepack pnpm build",
    "audit:routes": "node scripts/validate-route-manifest.mjs",
    "test:routes": "node scripts/run-route-audit.mjs",
    "verify:all": "npm run audit:routes && npm run lint && npm run test:unit && npm run build && npm --prefix apps/kadeai run verify",
    "test:backend:kadeai": "npm --prefix apps/kadeai run test:backend",
    "preview": "vite preview",
    "test:production": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.11",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.25",
    "nodemailer": "^9.0.3",
    "playwright": "^1.61.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.1",
    "sanitize-html": "^2.17.5",
    "three": "^0.183.2",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "latest",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.1.3"
  },
  "pnpm": {
    "overrides": {
      "sanitize-html": "2.17.5"
    }
  }
}