{
  "name": "kade-all-in-one",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:backend": "python -m pytest backend/tests -q",
    "test:bundle-secrets": "node scripts/check-client-secrets.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:bundle-secrets",
    "electron:dev": "next build && electron .",
    "electron:build": "next build && electron-builder",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:build:win": "next build && electron-builder --win",
    "electron:build:linux": "next build && electron-builder --linux",
    "postinstall": "node -e \"if(!process.env.CI && !process.env.VERCEL){require('child_process').execSync('electron-builder install-app-deps',{stdio:'inherit'})}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/generative-ai": "^0.24.1",
    "@next/env": "16.2.10",
    "@sentry/nextjs": "10.66.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.10",
    "openai": "^6.39.1",
    "posthog-js": "1.404.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
