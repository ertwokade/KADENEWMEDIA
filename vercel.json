{
  "crons": [
    {
      "path": "/api/reminders?action=check",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/links",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    },
    {
      "source": "/kadelinks",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    },
    {
      "source": "/kadelinks/:path*",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/kadeai",
      "destination": "https://kadeai.vercel.app/kadeai"
    },
    {
      "source": "/kadeai/:path*",
      "destination": "https://kadeai.vercel.app/kadeai/:path*"
    },
    {
      "source": "/",
      "destination": "/site.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https: data: blob:; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.google.com; worker-src 'self' blob:; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
