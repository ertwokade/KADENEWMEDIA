{
  "name": "@kade/studio-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx scripts/create-fixture.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@kade/db": "workspace:*",
    "@kade/editor-core": "workspace:*",
    "@kade/shared": "workspace:*",
    "bullmq": "latest",
    "dotenv": "latest",
    "dotenv-cli": "latest",
    "drizzle-orm": "latest",
    "execa": "latest",
    "openai": "latest"
  },
  "devDependencies": { "@types/node": "latest", "eslint": "latest", "tsx": "latest", "typescript": "latest", "typescript-eslint": "latest" }
}
