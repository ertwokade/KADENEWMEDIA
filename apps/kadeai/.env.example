# PUBLIC ROUTING (embedded in the browser bundle; changing requires rebuild)
NEXT_PUBLIC_BASE_PATH=/kadeai
NEXT_PUBLIC_APP_URL=https://kadenewmedia.com/kadeai
NEXT_PUBLIC_SITE_URL=https://kadenewmedia.com
NEXT_PUBLIC_KADE_OWNER_MODE=0

# AUTH + DATABASE
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only; required only for verified payment webhooks/admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-only; configure at least one for production)
AI_PROVIDER_MODE=live
# Vercel deployments use OIDC automatically; set this only outside Vercel.
AI_GATEWAY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_CREDITS_ENABLED=0
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
YOUTUBE_API_KEY=
OPERATIONS_AI_PROVIDER=auto
OPERATIONS_IMAGE_PROVIDER=gemini
OPERATIONS_IMAGE_MODEL=gemini-2.5-flash-image

# EMAIL (disabled | log | resend; log is rejected in production)
EMAIL_PROVIDER=disabled
EMAIL_FROM=KADE AI <no-reply@example.com>
RESEND_API_KEY=

# PAYMENTS (disabled | mock | shopier)
# Keep disabled until the prepared migration is reviewed and applied.
PAYMENT_PROVIDER=disabled
PAYMENT_SANDBOX_ENABLED=0
PAYMENT_WEBHOOK_SECRET=
SHOPIER_API_KEY=
SHOPIER_API_SECRET=

# SENTRY (all telemetry remains off unless explicitly enabled)
SENTRY_ENABLED=0
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=0
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# POSTHOG (client-side consent is also required)
NEXT_PUBLIC_POSTHOG_ENABLED=0
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-only salt used to pseudonymize analytics distinct IDs.
POSTHOG_HASH_SECRET=

# INTERNAL FASTAPI SERVICE (server-only)
KADE_FASTAPI_BASE_URL=http://127.0.0.1:8472
KADE_BACKEND_TOKEN=
KADE_PROVIDER_TIMEOUT_SECONDS=60

# DISTRIBUTED AI QUOTAS (server-only; recommended for atomic quotas)
# Without Upstash, authenticated Supabase generation history is used as a safe fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OWNER-ONLY FEATURES
KADE_OWNER_EMAIL=
KADE_OWNER_EMAILS=

# LOCAL DEVELOPMENT ONLY; never set to 1 in production.
KADE_DISABLE_AUTH=0

# CUSTOM/DYNAMIC OFFERS (kisiye ozel odeme linki - server-to-server)
# Legacy site admin panelinden bu uc noktaya istek atarken kullanilan paylasilan sir.
KADEAI_ADMIN_API_SECRET=
