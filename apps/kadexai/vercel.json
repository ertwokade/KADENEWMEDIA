{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm run legacy:build && node scripts/stage-static-into-next.mjs && cd apps/kadexai && npm run build",
  "installCommand": "cd ../.. && npm install && cd apps/kadexai && npm install",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/site.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/dynamic-page?type=blog&slug=:slug"
    },
    {
      "source": "/partnerler/:slug",
      "destination": "/api/dynamic-page?type=partner&slug=:slug"
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/api/dynamic-page?type=portfolio&slug=:slug"
    },
    {
      "source": "/s/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/@:handle",
      "destination": "/api/dynamic-page?type=profile&slug=:handle"
    },
    {
      "source": "/401",
      "destination": "/app.html"
    },
    {
      "source": "/403",
      "destination": "/app.html"
    },
    {
      "source": "/429",
      "destination": "/app.html"
    },
    {
      "source": "/bakim",
      "destination": "/app.html"
    },
    {
      "source": "/links",
      "destination": "/app.html"
    },
    {
      "source": "/kadelinks",
      "destination": "/app.html"
    },
    {
      "source": "/kadirdemir",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/kadeai/:path*",
      "destination": "/kadexai/:path*",
      "permanent": true
    },
    {
      "source": "/kadeai",
      "destination": "/kadexai",
      "permanent": true
    },
    {
      "source": "/kadirdemir",
      "destination": "/@kadirdemir",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    },
    {
      "source": "/kadelinks",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    },
    {
      "source": "/kadelinks/:path*",
      "destination": "https://kadirardademir.com/links",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https: data: blob:; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/kadexai/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminders?action=check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/kadexai/api/materials/sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/kadexai/api/kade-search/collect",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/kadexai/api/kade-search/daily-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/kadexai/api/reports/weekly-site",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/kadexai/api/subscriptions/sweep",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/kadexai/api/notifications/daily-summary",
      "schedule": "0 20 * * *"
    }
  ]
}
