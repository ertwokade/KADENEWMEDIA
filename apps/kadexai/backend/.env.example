# RUNTIME + AUTH (server-only)
KADE_ENV=development
KADE_BACKEND_TOKEN=generate-a-long-random-token-at-least-32-characters
KADE_MEDIA_ROOT=C:\path\to\approved-media
KADE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=0.0.0.0
PORT=8472

# OPTIONAL AI + YOUTUBE
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8472/oauth/youtube/callback

# VIDEO FABRIKASI (senaryodan otomatik video — vendored motor)
# Senaryo/görsel üretimi için AI anahtarı (biri yeterli):
GEMINI_API_KEY=
OPENAI_API_KEY=
# Stok görüntü (ücretsiz): https://www.pexels.com/api/
PEXELS_API_KEY=
# Alternatif stok görüntü (ücretsiz): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# OPTIONAL DATA SERVICES
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
KADE_PROVIDER_TIMEOUT_SECONDS=60
ENCRYPTION_KEY=
