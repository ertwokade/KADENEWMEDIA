# RUNTIME + CANONICAL URL
NODE_ENV=development
PORT=3001
SITE_URL=https://kadenewmedia.com

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/kademedia?retryWrites=true&w=majority

# Admin auth and browser security
# Use a random value with at least 32 characters.
JWT_SECRET=change-me-to-a-random-secret-with-32-plus-chars
ALLOWED_ORIGINS=http://localhost:5173,https://kadenewmedia.com

# Persistent rate limiting for production/serverless
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Scheduled reminders / seed hardening
CRON_SECRET=change-me-cron-secret-32-plus-chars
VERCEL_WEBHOOK_SECRET=optional-vercel-webhook-signature-secret
CRON_SIGNATURE_SECRET=optional-alternate-cron-signature-secret
SEED_SECRET=change-me-seed-secret-32-plus-chars
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ENDPOINT_ENABLED=false

# E-POSTA BİLDİRİMİ (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com

# WHATSAPP BİLDİRİMİ (Callmebot)
WA_PHONE=905XXXXXXXXX
WA_APIKEY=your-callmebot-api-key

# Gemini API Key (server-side only, optional)
GEMINI_API_KEY=your-gemini-api-key

# Signed unsubscribe token secret (optional — falls back to JWT_SECRET)
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret-32-plus-chars

# Google Analytics 4 Measurement ID (optional — has built-in fallback)
VITE_GA_ID=G-XXXXXXXXXX

# Google Analytics Data API (server-side only, optional admin reports)
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"

# Shopier Entegrasyonu
# Shopier paneli → API Ayarları → API Anahtarları kısmından alınır
SHOPIER_API_KEY=your-shopier-api-key
SHOPIER_API_SECRET=your-shopier-api-sifre
# Fail-closed catalog: only these product references can grant entitlements.
SHOPIER_ENABLED_PRODUCTS=kade-kit-baslangic-lifetime,kade-kit-baslangic-monthly,kade-kit-pro-lifetime,kade-kit-pro-monthly,kade-kit-ajans-lifetime,kade-kit-ajans-monthly
# Used when the signed Shopier webhook contract does not include a currency field.
SHOPIER_WEBHOOK_CURRENCY=TRY
# Shopier panelinde webhook URL olarak şunu girin:
# https://kadenewmedia.com/api/shopier

# OPTIONAL LOCAL AUDIT / ADMIN EXPORT SCRIPTS (never expose these to the browser)
AUDIT_URL=http://127.0.0.1:4173
KADE_ADMIN_BASE_URL=https://kadenewmedia.com
KADE_ADMIN_USER=
KADE_ADMIN_PASS=
KADE_DB_NAME=kademedia

# KADE STUDIO — local defaults
DATABASE_URL=postgresql://kade:kade@localhost:5432/kade_studio
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kade
S3_SECRET_ACCESS_KEY=kade-local-secret
S3_BUCKET=kade-studio
S3_FORCE_PATH_STYLE=true
OPENAI_API_KEY=
OPENAI_EDIT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_MODE=mock
APP_PASSWORD=
SESSION_SECRET=change-this-local-session-secret-with-32-characters
NEXT_PUBLIC_APP_NAME=Kade Studio
MAX_UPLOAD_MB=1024
NEXT_PUBLIC_MAX_UPLOAD_MB=1024
NEXT_PUBLIC_AI_MODE=mock
